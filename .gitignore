# distapi — .gitignore

# Binary output
dist/

# Data directory (temporary job files)
data/

# Materi lokal — tidak dipush ke remote
tmp/

# Go build cache
*.test

# Node.js (frontend dependencies — install with npm ci)
web/node_modules/

# Frontend build output — DI-COMMIT agar `go build` berjalan tanpa Node.js
# (konsisten dengan kebijakan gen/). Regenerasi lewat `make web`.

# IDE
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db
